input {
  beats {
    port => {{ logstash_beat_port }}
  }
  tcp {
    port => {{ logstash_tcp_port }}
    codec => json_lines
  }
}

filter {
  if [message] =~ /^\{.*\}$/ {
    json {
      source => "message"
      target => "log"
      skip_on_invalid_json => true
    }
  }

  grok {
    match => {
      "message" => "(?m)^%{TIMESTAMP_ISO8601:timestamp}\s+%{LOGLEVEL:log_level}\s+(\[(?<service_name>[^,]+)?,(?<trace_id>[^,]+)?,(?<span_id>[^\]]+)?\])?\s*%{NUMBER:pid:int}?\s*---\s*(\[(?<thread_name>[^\]]+)\])?\s*(?<logger>[^:]+)\s*:\s*%{GREEDYDATA:message_body}"
    }
    overwrite => [ "message" ]
    tag_on_failure => [ "_grok_spring_parse_failure" ]
  }

  date {
    match => [ "timestamp", "ISO8601", "yyyy-MM-dd HH:mm:ss.SSS", "yyyy-MM-dd'T'HH:mm:ss.SSSZ" ]
    target => "@timestamp"
    remove_field => [ "timestamp" ]
  }

  mutate {
    add_field => {
      "application" => "spring-petclinic"
    }
  }
}

output {
  elasticsearch {
    hosts => [ "http://{{ elasticsearch_host }}:{{ elasticsearch_port }}" ]
    index => "petclinic-logs-%{+YYYY.MM.dd}"
  }
}

